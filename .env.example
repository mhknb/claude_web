# Bu dosyanın adını ".env" olarak değiştirip değerleri doldurun.

# Zorunlu: NVIDIA NIM API anahtarı (ücretsiz): https://build.nvidia.com -> sağ üstte profil -> API Keys
NVIDIA_API_KEY=

# İsteğe bağlı: varsayılan model. Sayfadan her analizde değiştirilebilir.
LLM_MODEL=z-ai/glm-5.2

# İsteğe bağlı: Trend verisi için ücretsiz anahtar (ayda 100 sorgu): https://www.trendsmcp.ai/account
TRENDSMCP_API_KEY=

# İsteğe bağlı: Web, Reddit, Hacker News, Product Hunt ve haber araması (ücretsiz, anahtar gerekmez).
# Kapatmak için false yapın. Kapatırsanız web araması da kapanır.
RIVALSEARCH_ENABLED=true

# İsteğe bağlı: sayfanın açılacağı port
PORT=3000

# İleri düzey: OpenAI uyumlu başka bir servis kullanmak için (ör. z.ai kullandıkça öde API'si):
# LLM_BASE_URL=https://api.z.ai/api/paas/v4
# LLM_API_KEY=
# LLM_MIN_GAP_MS=1600   # istekler arası en az bekleme (ms); NVIDIA ücretsiz katmanı dakikada ~40 istek
