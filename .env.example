# Bu dosyanın adını ".env" olarak değiştirip değerleri doldurun.

# Zorunlu: Claude API anahtarı (https://platform.claude.com -> API Keys)
ANTHROPIC_API_KEY=

# İsteğe bağlı: Trend verisi için ücretsiz anahtar (ayda 100 sorgu): https://www.trendsmcp.ai/account
TRENDSMCP_API_KEY=

# İsteğe bağlı: Reddit, Hacker News, Product Hunt ve haber araması (ücretsiz, anahtar gerekmez).
# Kapatmak için false yapın.
RIVALSEARCH_ENABLED=true

# İsteğe bağlı: varsayılan model (claude-opus-5-5 veya claude-sonnet-5-5)
MODEL=claude-opus-5-5

# İsteğe bağlı: sayfanın açılacağı port
PORT=3000
