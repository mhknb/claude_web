         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       },
       "giant_safety": {
        "type": "object",
        "properties": {
         "score": {
          "type": "integer",
          "description": "Devlerden ve yapay zeka şirketlerinden güvenli mi: 0-10 arası tam sayı"
         },
         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       },
       "buildability": {
        "type": "object",
        "properties": {
         "score": {
          "type": "integer",
          "description": "1-2 kişi + yapay zeka ile yapılabilir mi: 0-10 arası tam sayı"
         },
         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       },
       "founder_fit": {
        "type": "object",
        "properties": {
         "score": {
          "type": "integer",
          "description": "Kurucu profiline uygun mu: 0-10 arası tam sayı"
         },
         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       }
      },
      "required": [
       "pain",
       "willingness_to_pay",
       "market_room",
       "reachability",
       "giant_safety",
       "buildability",
       "founder_fit"
      ],
      "additionalProperties": false
     },
     "legal_risk": {
      "type": "string",
      "enum": [
       "düşük",
       "orta",
       "yüksek"
      ],
      "description": "Yasal risk seviyesi"
     },
     "main_risk": {
      "type": "string",
      "description": "En büyük risk"
     }
