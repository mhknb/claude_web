{
 "type": "object",
 "properties": {
  "tur": {
   "type": "string",
   "const": "kesif"
  },
  "meta": {
   "type": "object",
   "description": "Rapor bilgileri",
   "properties": {
    "baslik": {
     "type": "string"
    },
    "tarih": {
     "type": "string",
     "description": "YYYY-AA-GG"
    },
    "pazar": {
     "type": "string",
     "enum": [
      "Türkiye",
      "Global",
      "İkisi"
     ]
    },
    "kullanilan_kaynaklar": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Bu analizde gerçekten kullanılan veri kaynakları/araçlar"
    },
    "sinirlamalar": {
     "type": "array",
     "items": {
      "type": "string"
     },
     "description": "Ortamın yapamadığı ve bu yüzden eksik kalanlar"
    }
   },
   "required": [
    "baslik",
    "tarih"
   ]
  },
  "market_notes": {
   "type": "string",
   "description": "Araştırılan alan ve pazar hakkında genel gözlem, 3-5 cümle"
  },
  "excluded_audiences": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "audience": {
      "type": "string",
      "description": "Elenen kitle"
     },
     "reason": {
      "type": "string",
      "description": "Neden elendi (ör. ödeme alışkanlığı yok)"
     }
    },
    "required": [
     "audience",
     "reason"
    ],
    "additionalProperties": false
   },
   "description": "Para vermeyeceği için elenen kitleler"
  },
  "candidates": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "description": "Kısa çalışma adı"
     },
     "one_liner": {
      "type": "string",
      "description": "Tek cümlelik ürün tanımı"
     },
     "product_type": {
      "type": "string",
      "enum": [
       "mobil uygulama",
       "SaaS",
       "yapay zeka aracı",
       "tarayıcı eklentisi",
       "web uygulaması",
       "diğer"
      ],
      "description": "Ürün tipi"
     },
     "market": {
      "type": "string",
      "enum": [
       "Türkiye",
       "Global",
       "İkisi"
      ],
      "description": "Hedef pazar"
     },
     "target_audience": {
      "type": "string",
      "description": "Kime satılacak, net ve dar tanım"
     },
     "problem": {
      "type": "string",
      "description": "Çözülen problem, kullanıcının diliyle"
     },
     "why_they_pay": {
      "type": "string",
      "description": "Bu kitlenin para vereceğine dair kanıt (bugün neye para ödüyorlar?)"
     },
     "existing_alternatives": {
      "type": "string",
      "description": "Bugün bu problemi nasıl çözüyorlar, hangi rakipler var"
     },
     "gap": {
      "type": "string",
      "description": "Rakiplerin bıraktığı boşluk"
     },
     "evidence": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "claim": {
         "type": "string",
         "description": "Kanıtlanan iddia, kısa"
        },
        "url": {
         "type": "string",
         "description": "Kaynak linki. Kaynak yoksa boş bırakma, iddiayı hiç yazma."
        }
       },
       "required": [
        "claim",
        "url"
       ],
       "additionalProperties": false
      },
      "description": "En az 3 kaynaklı kanıt"
     },
     "scores": {
      "type": "object",
      "description": "Her bileşen 0-10. Yüksek puan her zaman iyi demektir.",
      "properties": {
       "pain": {
        "type": "object",
        "properties": {
         "score": {
          "type": "integer",
          "description": "Problemin acısı ve sıklığı: 0-10 arası tam sayı"
         },
         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       },
       "willingness_to_pay": {
        "type": "object",
