         "confidence": {
          "type": "string",
          "enum": [
           "düşük",
           "orta",
           "yüksek"
          ],
          "description": "Bu puanın dayandığı kanıtın gücü. Kanıt yoksa 'düşük'."
         },
         "reason": {
          "type": "string",
          "description": "Puanın gerekçesi, kanıta dayalı, 1-2 cümle"
         }
        },
        "required": [
         "score",
         "confidence",
         "reason"
        ],
        "additionalProperties": false
       },
       "reachability": {
        "type": "object",
        "properties": {
         "score": {
          "type": "integer",
          "description": "Kitleye ucuza ulaşılabilir mi: 0-10 arası tam sayı"
