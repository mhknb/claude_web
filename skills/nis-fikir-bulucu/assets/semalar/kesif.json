    "required": [
     "name",
     "one_liner",
     "product_type",
     "market",
     "target_audience",
     "problem",
     "why_they_pay",
     "existing_alternatives",
     "gap",
     "evidence",
     "scores",
     "legal_risk",
     "main_risk"
    ],
    "additionalProperties": false
   },
   "description": "Aday niş fikirler"
  },
  "ek_grafikler": {
   "type": "array",
   "description": "İsteğe bağlı ek grafikler (Chart.js). Sadece gerçek veriyle.",
   "items": {
    "type": "object",
    "properties": {
     "baslik": {
      "type": "string"
     },
     "tur": {
      "type": "string",
      "enum": [
       "bar",
       "line",
       "pie",
       "doughnut",
       "radar",
       "scatter"
      ]
     },
     "etiketler": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "seriler": {
      "type": "array",
      "items": {
       "type": "object",
       "properties": {
        "ad": {
         "type": "string"
        },
        "veri": {
         "type": "array"
        }
       },
       "required": [
        "ad",
        "veri"
       ]
      }
     },
     "aciklama": {
      "type": "string",
      "description": "Grafiğin ne gösterdiği ve verinin kaynağı"
     },
     "kaynak_url": {
      "type": "string"
     }
    },
    "required": [
     "baslik",
     "tur",
     "seriler"
    ]
   }
  },
  "ek_bolumler": {
   "type": "array",
   "description": "İsteğe bağlı ek bölümler (düz metin/markdown benzeri; HTML kabul edilmez)",
   "items": {
    "type": "object",
    "properties": {
     "baslik": {
      "type": "string"
     },
     "metin": {
      "type": "string"
     },
     "tablo": {
      "type": "object",
      "properties": {
       "basliklar": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "satirlar": {
        "type": "array",
        "items": {
         "type": "array",
         "items": {
          "type": "string"
         }
        }
       }
      },
      "required": [
       "basliklar",
       "satirlar"
      ]
     }
    },
    "required": [
     "baslik"
    ]
   }
  }
 },
 "required": [
  "tur",
  "meta",
  "market_notes",
  "excluded_audiences",
  "candidates"
 ],
 "additionalProperties": false,
 "$schema": "https://json-schema.org/draft/2020-12/schema"
}